DATABASE_URL="file:./prisma/dev.db"
APP_URL="http://localhost:3000"
# Required to send mail. Without SMTP, delivery stays pending for retry.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Secret Santa <santa@example.com>"
# Optional. Leave empty to allow creating draws without a password, including in production.
ORGANIZER_PASSWORD=""
